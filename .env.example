# Заполните один токен, без Bearer. Пустой файл не даёт доступа к аккаунту.
ITD_TOKEN=
ITD_REFRESH_TOKEN=
ITD_SESSION_PATH=.itd-session.json

# Настройки передаются через bot.poll_options и bot.dispatcher_options.
ITD_WORKERS=4
ITD_POLL_INTERVAL=5
ITD_READ_MODE=blocking

# Необязательно: поля RateLimitConfig с префиксом ITD_RATE_.
# ITD_RATE_REQUESTS_PER_MINUTE=80
# ITD_RATE_SEND_INTERVAL=2.1
# ITD_RATE_ENABLED=true
# ITD_RATE_WAIT=true
